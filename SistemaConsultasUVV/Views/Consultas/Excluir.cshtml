@model SistemaConsultasUVV.Models.Consulta

@{
    ViewData["Title"] = "Excluir Consulta";
}

<h2>Excluir Consulta</h2>

<p>Tem certeza que deseja excluir esta consulta?</p>

<dl>
    <dt>Especialidade</dt>
    <dd>@Model.Especialidade</dd>
    <dt>Data/Hora</dt>
    <dd>@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt>Descrição</dt>
    <dd>@Model.Descricao</dd>
</dl>

<form asp-action="Excluir" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>